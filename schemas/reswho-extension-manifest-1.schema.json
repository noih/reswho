{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reswho.local/schemas/reswho-extension-manifest-1.schema.json",
  "title": "reswho extension manifest protocol1",
  "type": "object",
  "required": [
    "id",
    "version",
    "engines",
    "protocol_version",
    "platforms",
    "capabilities",
    "executable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "engines": {
      "type": "object",
      "required": [
        "reswho"
      ],
      "properties": {
        "reswho": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 0
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "collect",
          "classify",
          "details"
        ]
      }
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "description": "Native macOS executable for the host architecture; scripts and interpreter payloads are unsupported."
    },
    "args": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "definitions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "uses": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/use"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "definition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "integer": {
          "const": true
        },
        "default": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "description": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "type",
        "default",
        "description",
        "sensitive"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "number"
                }
              },
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "integer"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "boolean"
                }
              },
              "default": {
                "type": "boolean"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "integer"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "integer"
            ],
            "properties": {
              "integer": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "integer"
                }
              },
              "default": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "use": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "integer": {
          "const": true
        }
      },
      "required": [
        "key",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "string"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "integer"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "boolean"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "integer"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "integer"
            ],
            "properties": {
              "integer": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
