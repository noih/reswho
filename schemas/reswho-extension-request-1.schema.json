{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reswho:extension:request:1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "host": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "protocol_version": {
          "const": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 64
        }
      },
      "required": [
        "version",
        "protocol_version",
        "features"
      ],
      "additionalProperties": true
    },
    "capability": {
      "enum": [
        "collect",
        "classify",
        "details"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "collect_scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "containers",
          "resources"
        ]
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "started_unix_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "ppid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "uid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "executable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "pid",
          "started_unix_us",
          "ppid",
          "uid",
          "name",
          "executable",
          "cwd"
        ],
        "additionalProperties": true
      },
      "maxItems": 16384
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "started_unix_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "ppid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "executable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pid",
        "started_unix_us",
        "ppid",
        "uid",
        "name",
        "executable",
        "cwd"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "protocol_version",
    "host",
    "provider",
    "version",
    "capability",
    "settings"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "const": "collect"
          }
        }
      },
      "then": {
        "required": [
          "collect_scopes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capability": {
            "const": "classify"
          }
        }
      },
      "then": {
        "required": [
          "processes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capability": {
            "const": "details"
          }
        }
      },
      "then": {
        "required": [
          "process"
        ]
      }
    }
  ]
}
