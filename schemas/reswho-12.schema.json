          },
          "phase": {
            "enum": [
              "read",
              "validate",
              "register",
              "collect",
              "classify",
              "details"
            ]
          },
          "result": {
            "enum": [
              "success",
              "failed",
              "skipped",
              "never_invoked"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "duration_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
