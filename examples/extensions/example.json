{
  "id": "example",
  "version": "1.0.0",
  "engines": {
    "reswho": ">=0.1.0 <0.2.0"
  },
  "protocol_version": 1,
  "platforms": [
    "macos"
  ],
  "capabilities": [
    "classify",
    "details",
    "collect"
  ],
  "executable": "../../target/debug/examples/extension_example",
  "uses": [
    {
      "key": "sampling.interval_ms",
      "type": "number",
      "unit": "ms",
      "integer": true,
      "min": 200,
      "max": 5000
    }
  ],
  "collect_scopes": [
    "resources"
  ],
  "required_features": [
    "roles",
    "resources",
    "collect_scopes"
  ]
}
